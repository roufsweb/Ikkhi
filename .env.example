# Ikkhi Environment Variables
# Copy this file to .env and fill in your keys

# Google AI Studio API Key & Project ID (used strictly on-demand for visual Q&A & fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_ID=your_project_id_here

# Wake Word & Hotkey settings
WAKE_WORD=hey ikkhi
PUSH_TO_TALK_KEY=ctrl+alt+space
